{
  "dataset": "mosei",
  "language": "en",
  "cache_dir": "data/feature_cache/mosei",
  "run_root": "runs/feature_baselines",
  "seeds": [13, 42, 2026],
  "model": {
    "name": "text_mlp",
    "params": {
      "pooling": "cls",
      "hidden_dim": 256,
      "dropout": 0.1
    }
  },
  "training": {
    "max_epochs": 80,
    "batch_size": 32,
    "patience": 12,
    "min_delta": 0.0,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "grad_clip_norm": 1.0,
    "scheduler_patience": 3,
    "scheduler_factor": 0.5,
    "num_workers": 0,
    "device": "auto",
    "amp": false,
    "amp_dtype": "float16"
  }
}
